<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رونویس فارسی"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تبدیل آفلاین فایل WAV فارسی به متن"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="18dp" />

        <Button
            android:id="@+id/loadModelBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۱. انتخاب و بارگذاری مدل BIN" />

        <Button
            android:id="@+id/selectAudioBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۲. انتخاب فایل WAV"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/selectedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="هنوز فایلی انتخاب نشده است"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/transcribeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۳. شروع تبدیل"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آماده"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <EditText
            android:id="@+id/sample_text"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:gravity="top|start"
            android:hint="متن رونویسی اینجا نمایش داده می‌شود"
            android:inputType="textMultiLine"
            android:textDirection="rtl"
            android:scrollbars="vertical"
            android:padding="12dp" />

        <Button
            android:id="@+id/shareBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اشتراک متن"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ذخیره TXT" />

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پاک‌کردن" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخه آزمایشی فعلی فقط فایل WAV را پشتیبانی می‌کند."
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="14dp" />
    </LinearLayout>
</ScrollView>
